# Copy to .env and fill in the contract address after deploying

# v3 contract address is written here only after scripts/live_studionet_proof.py
# proves FINALIZED + FINISHED_WITH_RETURN and exact source parity.
VITE_CONTRACT_ADDRESS=

# V4 TrustPass contract address (public configuration; set after the V4
# contract is independently deployed and verified on Studionet 61999).
VITE_V4_TRUSTPASS_CONTRACT_ADDRESS=

# Arc Testnet 5042002 (public configuration).
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
VITE_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
VITE_ARC_ESCROW_ADDRESS=

# Optimism Sepolia Human Passport decoder (public read configuration).
VITE_HUMAN_PASSPORT_RPC_URL=https://sepolia.optimism.io
VITE_HUMAN_PASSPORT_DECODER_ADDRESS=0xe53C60F8069C2f0c3a84F9B3DB5cf56f3100ba56

# Cloudflare Worker backend base URL, without /api at the end.
# Example: https://soulstamp-discord.your-cloudflare-subdomain.workers.dev
VITE_DISCORD_BACKEND_URL=https://soulstamp-discord.your-cloudflare-subdomain.workers.dev

# Same Worker origin, with Google OAuth enabled only after the user configures
# a real Google Cloud client and Worker secrets.
VITE_GOOGLE_WORKER_URL=https://soulstamp-discord.your-cloudflare-subdomain.workers.dev

