# Local release-only values. Copy to the ignored repository-root .env.
# Never commit real keys or put them in frontend/Worker configuration.
SOULSTAMP_ADMIN_ADDRESS=replace-with-public-admin-address
GENLAYER_PRIVATE_KEY=replace-with-deployer-private-key
# Needed only for lifecycle steps using "signer": "admin".
SOULSTAMP_ADMIN_PRIVATE_KEY=replace-with-admin-private-key

# Deployment aliases are accepted from the ignored .env.test-wallets.local.
# ARC_PRIVATE_KEY and GENLAYER_PRIVATE_KEY are never public configuration.
ARC_PRIVATE_KEY=
ARC_ADMIN_ADDRESS=
ARC_TREASURY_ADDRESS=
ARC_SETTLEMENT_OPERATOR_ADDRESS=
ARC_SETTLEMENT_OPERATOR_PRIVATE_KEY=
ARC_REFUND_PRIVATE_KEY=
V4_ADMIN_ADDRESS=
V4_DEPLOYMENT_TRANSACTION=
V4_EXPECTED_SOURCE_SHA256=

# V4 public deployment configuration (addresses only; never put a key here).
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_ESCROW_ADDRESS=
V4_TRUSTPASS_CONTRACT_ADDRESS=
V3_SOULSTAMP_CONTRACT_ADDRESS=0x4ed8aF93E64F6411826DeEaa6d2af68DD67C9c3d
HUMAN_PASSPORT_CHAIN_ID=11155420
HUMAN_PASSPORT_RPC_URL=https://sepolia.optimism.io
HUMAN_PASSPORT_DECODER_ADDRESS=0xe53C60F8069C2f0c3a84F9B3DB5cf56f3100ba56
GOOGLE_ATTESTATION_BASE_URL=https://soulstamp-discord.delealufejoel.workers.dev

# Worker-only secrets. Set with wrangler secret put; never put these in Vercel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ACCOUNT_COMMITMENT_SECRET=
BACKEND_SESSION_SECRET=
