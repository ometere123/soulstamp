# Discord-only Cloudflare Workers backend.
# This backend must be publicly reachable by GenLayer validators.

FRONTEND_ORIGIN=https://your-vercel-frontend.vercel.app
PUBLIC_BASE_URL=https://soulstamp-discord.your-cloudflare-subdomain.workers.dev
BACKEND_SESSION_SECRET=replace-with-a-long-random-secret

DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_REDIRECT_URI=https://soulstamp-discord.your-cloudflare-subdomain.workers.dev/api/discord/callback

# Google OIDC public/client configuration. Keep the client secret and the
# commitment secret in Cloudflare Worker secrets, never in this file.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=https://soulstamp-discord.your-cloudflare-subdomain.workers.dev/api/google/callback
# GOOGLE_CLIENT_SECRET=<set with wrangler secret put>
# GOOGLE_ACCOUNT_COMMITMENT_SECRET=<set with wrangler secret put>
